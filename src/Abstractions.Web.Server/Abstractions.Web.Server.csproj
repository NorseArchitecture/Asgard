<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<Description>Norse web-server abstractions: IDeferredSignIn (the hosting-concern contract Midgard's Infrastructure.Web.Server implements against, so Himinbjorg's identity layer never depends on Midgard directly) and the mediator law surface — the IRequest/ICommandRequest/IQueryRequest marker family, IRequestHandler, ISender/ISenderDispatch, IBehavior, IPrincipalAccessor — the server-side law for the web tier. The marker family lives here rather than Norse.Abstractions.Contracts deliberately: server-only law in the server-only assembly, so a WASM-shipped wire assembly cannot even reference it. CommandRequest&lt;TRequest,TResponse&gt; is the server-sovereign wrapper a realm derives to give a pure wire DTO its mediator identity ([Authorize], handler binding) without the wire type itself ever carrying a marker; CommandRequestValidator&lt;TCommand,TRequest,TResponse&gt; is the generated pass-through adapter that reuses the wrapped wire type's own validators unchanged, verbatim property names. Bundles the handler-registration generator (analyzers/dotnet/cs/), which discovers a realm's IRequestHandler/IValidator implementations at compile time and emits AddNorse{Realm}Handlers() — including, for every wrapper command, the CommandRequestValidator registration. IWebHostPlugin and IDocumentRepository&lt;T&gt; are scaffolded, not yet implemented. Mutually invisible with Norse.Abstractions.Worker.</Description>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.*" />
		<ProjectReference Include="../Abstractions.Backend/Abstractions.Backend.csproj" />
		<ProjectReference Include="../Abstractions.Components/Abstractions.Components.csproj" />
		<ProjectReference
			Include="../../gen/Abstractions.Web.Server.Generator/Abstractions.Web.Server.Generator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false" />
	</ItemGroup>
	<Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
		<MSBuild Projects="../../gen/Abstractions.Web.Server.Generator/Abstractions.Web.Server.Generator.csproj"
			Targets="Build"
			Properties="Configuration=$(Configuration)" />
		<ItemGroup>
			<None Include="../../gen/Abstractions.Web.Server.Generator/bin/$(Configuration)/netstandard2.0/Norse.Abstractions.Web.Server.Generator.dll"
				Pack="true"
				PackagePath="analyzers/dotnet/cs/"
				Visible="false" />
			<None Include="../../gen/Abstractions.Web.Server.Generator/bin/$(Configuration)/netstandard2.0/Norse.Abstractions.Emit.dll"
				Pack="true"
				PackagePath="analyzers/dotnet/cs/"
				Visible="false" />
		</ItemGroup>
	</Target>
</Project>
